%% ====================================================================
%% Complete Virtual Machine Functional Topology (7-VM Testbed)
%% ====================================================================

    %% ----------------------------------------------------
    %% VM-5: nrUE Softmodem Emulator
    %% ----------------------------------------------------
    subgraph VM5 ["<b>VM-5: User Equipment (UEs)</b><br/>IP: 10.102.0.165 • 4 vCPU, 8 GB RAM"]
        UE1["UE-1 (eMBB, SST=1, SD=0x01)<br/>netns: ue1 | IP: 12.1.1.2"]
        UE2["UE-2 (URLLC, SST=2, SD=0x7b)<br/>netns: ue2 | IP: 12.1.2.2"]
        TRAFGEN["Traffic Generator (iperf3 / ping)"]
        UE1 --- TRAFGEN
        UE2 --- TRAFGEN
    end

    %% ----------------------------------------------------
    %% VM-4: OAI Split RAN
    %% ----------------------------------------------------
    subgraph VM4 ["<b>VM-4: O-RAN Radio Access Network (gNodeB)</b><br/>IP: 10.102.0.167 • 8 vCPU, 16 GB RAM"]
        ODU["O-DU (Cell-1 :4043 & Cell-2 :4044)<br/>OAI RFSim Servers"]
        CUCP["O-CU-CP (RRC/NGAP)"]
        CUUP["O-CU-UP (PDCP/SDAP/GTP-U)"]
        E2A["O-RAN E2 Agent (FlexRIC)"]

        ODU -- "F1-C" --> CUCP
        ODU -- "F1-U" --> CUUP
    end

    %% ----------------------------------------------------
    %% VM-3: 5G Core Network
    %% ----------------------------------------------------
    subgraph VM3 ["<b>VM-3: 5G Core Network (Multi-Slice 5GC)</b><br/>IP: 10.102.0.246 • 8 vCPU, 16 GB RAM"]
        subgraph CP_5GC ["5GC Control Plane NFs"]
            AMF["AMF (Mobility)"]
            SMF["SMF (Session)"]
            PCF["PCF (Policy Control)"]
            NSSF["NSSF (Slice Selection)"]
            COMMON_CP["NRF / UDM / AUSF / UDR"]
            AMF --- SMF
            SMF --- PCF
            AMF --- NSSF
        end

        subgraph UP_5GC ["5GC User Plane NFs"]
            UPF1["UPF-1 (eMBB, SST=1)"]
            UPF2["UPF-2 (URLLC, SST=2)"]
            DN["Data Network (DN / Internet)"]
            UPF1 -- "N6" --> DN
            UPF2 -- "N6" --> DN
        end
    end

    %% ----------------------------------------------------
    %% VM-07: Standalone 3GPP NWDAF
    %% ----------------------------------------------------
    subgraph VM7 ["<b>VM-07: Standalone 3GPP NWDAF (AnLF)</b><br/>IP: 10.102.0.233 • 4 vCPU, 8 GB RAM"]
        NWDAF_ENG["NWDAF Engine & SBI (:6062/:6063)"]
        KONG_GW["Kong API Gateway (:8080)"]
        MONGO_DB["MongoDB (testing.smf / qosmonlist)"]
        NWDAF_ENG --- KONG_GW
        NWDAF_ENG --- MONGO_DB
    end

    %% ----------------------------------------------------
    %% VM-2: O-RAN Near-RT RIC
    %% ----------------------------------------------------
    subgraph VM2 ["<b>VM-2: Near-RT RIC</b><br/>IP: 10.102.0.232 • 4 vCPU, 8 GB RAM"]
        E2T["E2 Termination (E2T)"]
        A1M["A1 Mediator"]
        XAPP["Diagnostic xApp (Inference Engine)"]
        DBAAS["RIC Database / SDL (RNIB / Redis)"]

        E2T --- XAPP
        A1M --- XAPP
        XAPP --- DBAAS
    end

    %% ----------------------------------------------------
    %% VM-1: O-RAN Non-RT RIC & SMO
    %% ----------------------------------------------------
    subgraph VM1 ["<b>VM-1: Non-RT RIC & SMO</b><br/>IP: 10.102.0.168 • 4 vCPU, 8 GB RAM"]
        SMO["SMO Platform (Service Management & Orchestration)"]
        A1_PMS["A1 Policy Management Service"]
        RAPP["Diagnostic rApp / Offline Model Training"]
        SMO --- A1_PMS
        SMO --- RAPP
    end

    %% ----------------------------------------------------
    %% VM-6: Observability / Telemetry Platform
    %% ----------------------------------------------------
    subgraph VM6 ["<b>VM-6: Observability Host</b><br/>IP: 10.102.0.67 • 4 vCPU, 8 GB RAM"]
        COLLECTOR["Metrics Exporter & Collector"]
        PROM["Prometheus TSDB (1.0 Hz)"]
        GRAF["Grafana Dashboard"]
        COLLECTOR --> PROM
        PROM --> GRAF
    end

    %% ----------------------------------------------------
    %% 3GPP Standard Interfaces
    %% ----------------------------------------------------
    UE1 == "Emulated Uu (OAI RFSim)" ==> ODU
    UE2 == "Emulated Uu (OAI RFSim)" ==> ODU
    CUCP -- "N2 / NGAP (SCTP :38412)" --> AMF
    CUUP -- "N3 / GTP-U (UDP :2152)" --> UPF1
    CUUP -- "N3 / GTP-U (UDP :2152)" --> UPF2

    %% NWDAF Event Exposure
    SMF -- "Nsmf_EventExposure (QOS_MON)" --> NWDAF_ENG

    %% ----------------------------------------------------
    %% O-RAN Standard Interfaces
    %% ----------------------------------------------------
    E2A -- "E2AP (SCTP :36421)" --> E2T
    A1_PMS -- "A1-P (REST :10001)" --> A1M

    %% ----------------------------------------------------
    %% Telemetry Collection Channels
    %% ----------------------------------------------------
    ODU -. "MAC Scheduler Logs" .-> COLLECTOR
    UPF1 -. "tc qdisc / drops" .-> COLLECTOR
    TRAFGEN -. "Active Probes" .-> COLLECTOR
    KONG_GW -. "Nnwdaf_AnalyticsInfo (:8080)" .-> COLLECTOR
