%% ========================================================
%% System Architecture Overview: O-RAN RIC - NWDAF Coordination
%% ========================================================

    %% VM-5: OAI nrUE
    subgraph VM5 ["VM-5 — OAI nrUE (10.102.0.165 / 10.10.10.15)"]
        UE1["UE-1: eMBB"]
        UE2["UE-2: URLLC-like"]
    end

    %% VM-4: OAI RAN
    subgraph VM4 ["VM-4 — OAI RAN (10.102.0.167 / 10.10.10.14)"]
        subgraph VM4_DU ["Distributed Units (DUs)"]
            DU1["DU-1 (Cell-1, PCI 1, Port 4043)"]
            DU2["DU-2 (Cell-2, PCI 2, Port 4044)"]
        end

        subgraph VM4_CU ["Central Unit (CU)"]
            CU_CP["CU-CP (RRC / PDCP-C)"]
            CU_UP["CU-UP (SDAP / PDCP-U)"]
        end

        E2_AGENT["E2 Agent (FlexRIC: KPM / RC)"]
    end

    %% VM-3: OAI 5G Core & NWDAF (UPDATED)
    subgraph VM3 ["VM-3 — OAI 5G Core & NWDAF (10.102.0.164 / 10.10.10.13)"]
        subgraph VM3_5GC ["5G Core Network Functions"]
            AMF["AMF (Access & Mobility)"]
            SMF["SMF (Session Management)"]
            CORE_CP["NSSF / NRF / UDM / UDR / AUSF"]
            UPF["UPF Multi-Slice (UPF-1: eMBB / UPF-2: URLLC)"]
        end

        subgraph VM3_NWDAF ["3GPP NWDAF & Core Adaptation"]
            NWDAF_ENG["Native OAI NWDAF Microservices & Engine"]
            KONG["Kong API Gateway (Port 8080)"]
            CORE_ADAPT["Core Adapter / UPF Shaper"]
        end
    end

    %% VM-1: Non-RT RIC (UPDATED)
    subgraph VM1 ["VM-1 — Non-RT RIC (10.102.0.168 / 10.10.10.11)"]
        RAPP["Bottleneck-Aware rApp (Telemetry Aggregator, Classifier & SLA Policy)"]
        A1_PMS["A1 Policy Management Service (A1 PMS v2.6.0)"]
    end

    %% VM-2: Near-RT RIC
    subgraph VM2 ["VM-2 — Near-RT RIC (10.102.0.66 / 10.10.10.12)"]
        A1_MED["A1 Mediator"]
        XAPP["QoS Traffic-Steering xApp (Near-RT Control)"]
        SUB_MGR["Subscription Manager"]
        E2_TERM["E2 Termination (E2Term)"]
        E2_MGR["E2 Manager (E2Mgr)"]
        RNIB["RNIB / DBaaS (Redis 5.0.9)"]
    end

    %% VM-6: Monitoring & Experimentation
    subgraph VM6 ["VM-6 — Monitoring & TSDB (10.102.0.67 / 10.10.10.16)"]
        PROM["Prometheus TSDB"]
        GRAF["Grafana Dashboards"]
        LOGGER["Experiment Logger (Latency / Loss / Churn)"]
    end

    %% ----------------------------------------------------
    %% Internal Connections within Subgraphs
    %% ----------------------------------------------------

    %% VM-4 Internal
    DU1 -- "F1-C" --> CU_CP
    DU1 -- "F1-U" --> CU_UP
    DU2 -- "F1-C" --> CU_CP
    DU2 -- "F1-U" --> CU_UP
    CU_CP -.-> E2_AGENT
    CU_UP -.-> E2_AGENT

    %% VM-3 Internal (Core & NWDAF Interactions)
    AMF -- "N11" --> SMF
    SMF -- "N4 / PFCP" --> UPF
    CORE_CP -.-> SMF
    UPF -. "Nupf / User-Plane Metrics" .-> NWDAF_ENG
    SMF -. "Slice Load Info" .-> NWDAF_ENG
    NWDAF_ENG --- KONG
    CORE_ADAPT -. "Rate-Limiting / Shaping" .-> UPF

    %% VM-1 Internal
    RAPP --> A1_PMS

    %% VM-2 Internal
    A1_MED -- "RMR 20010" --> XAPP
    XAPP -- "RIC Subscription" --> SUB_MGR
    SUB_MGR --> E2_TERM
    E2_TERM -- "KPI / E2 Indication" --> XAPP
    XAPP -- "E2 Control (E2SM-RC)" --> E2_TERM
    E2_TERM -. "E2 Setup / Inventory" .-> E2_MGR
    E2_MGR --> RNIB

    %% VM-6 Internal
    PROM --> GRAF
    PROM --> LOGGER

    %% ----------------------------------------------------
    %% Cross-Domain & Inter-VM Connections
    %% ----------------------------------------------------

    %% Radio / Access Interface
    UE1 == "RFsim (Cell-1, Port 4043)" ==> DU1
    UE2 == "RFsim (Cell-2, Port 4044)" ==> DU2

    %% 3GPP 5G Interfaces (RAN to Core)
    CU_CP -- "N2 / NGAP (SCTP :38412)" --> AMF
    CU_UP -- "N3 / GTP-U (UDP :2152)" --> UPF

    %% O-RAN E2 Interface (RAN to Near-RT RIC)
    E2_AGENT <== "E2 / SCTP (Port 36421)" ==> E2_TERM

    %% O-RAN A1 Interface (Non-RT RIC to Near-RT RIC)
    A1_PMS -- "A1 Interface (REST :10001)" --> A1_MED

    %% 3GPP Nnwdaf Interface & Core Adaptation (Core to Non-RT RIC)
    KONG -- "Nnwdaf API Exposure (SliceLoadLevel, Delay, Loss)" --> RAPP
    RAPP -. "Core Shaping Targets" .-> CORE_ADAPT

    %% Telemetry & Monitoring Lines (Dotted)
    UE1 & UE2 -. "UE QoS" .-> LOGGER
    DU1 & DU2 -. "PRB Metrics / MAC KPI" .-> PROM
    CU_UP -. "PDCP / User-Plane Metrics" .-> PROM
    NWDAF_ENG -. "Core & Slice Metrics" .-> PROM
    XAPP -. "RIC Logs & Decisions" .-> LOGGER
