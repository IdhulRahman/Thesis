flowchart LR
%% ====================================================================
%% Multi-Timescale Control & Proposed Research Mechanism
%% Bottleneck-Aware Closed-Loop Traffic Steering via O-RAN RIC–NWDAF
%% ====================================================================

    %% ----------------------------------------------------
    %% Domain 1: Multi-Domain Telemetry & Observation
    %% ----------------------------------------------------
    subgraph OBSERVATION ["Observation & Telemetry Aggregation"]
        RAN_KPI["RAN Telemetry (E2SM-KPM: PRB, CQI, RLC Delay, Loss)"]
        CORE_METRICS["Core Telemetry (3GPP NWDAF: SliceLoadLevel, UPF Queue Delay, Packet Loss)"]
        E2E_QOS["End-to-End SLA Performance (Throughput, Latency, Loss, Jitter)"]
    end

    %% ----------------------------------------------------
    %% Domain 2: Slow Loop — Non-RT RIC Coordinator (~30 s Timescale)
    %% ----------------------------------------------------
    subgraph SLOW_LOOP ["Slow Loop: Non-RT RIC Coordinator (~30 s | VM-1)"]
        CROSS_AGG["Cross-Domain Telemetry Aggregator"]
        CLASSIFIER["Bottleneck Classification Engine (NORMAL / RAN / CORE / JOINT)"]
        POLICY_GEN["Action Selector & Policy Generator"]
        SLA_VERIFY["Closed-Loop SLA Verifier (Suppresses Action Churn)"]

        CROSS_AGG --> CLASSIFIER
        CLASSIFIER --> POLICY_GEN
        POLICY_GEN --> SLA_VERIFY
        SLA_VERIFY -. "Feedback / Churn Control" .-> POLICY_GEN
    end

    %% ----------------------------------------------------
    %% Domain 3: Fast Loop — Near-RT RIC Controller (10 ms - 1 s Timescale)
    %% ----------------------------------------------------
    subgraph FAST_LOOP ["Fast Loop: Near-RT RIC Controller (10 ms - 1 s | VM-2)"]
        A1_POLICY["A1 Policy Type 20008 (SLA Bounds & Cell Steering Guidance)"]
        XAPP["Bottleneck-Aware Traffic-Steering xApp"]

        A1_POLICY --> XAPP
    end

    %% ----------------------------------------------------
    %% Domain 4: Actuation & Enforcement Layer
    %% ----------------------------------------------------
    subgraph ACTUATION ["Multi-Domain Actuation Layer"]
        RAN_ACT["OAI RAN CU/DUs (Cell-1 <-> Cell-2 Handover Execution)"]
        CORE_ACT["Core Adapter (UPF Traffic Shaping & Rate-Limiting via tc)"]
    end

    %% ----------------------------------------------------
    %% Domain 5: Sliced Data Plane & End-to-End UEs
    %% ----------------------------------------------------
    subgraph DATA_PLANE ["Multi-Slice 5G Data Plane (VM-5 & Core UPFs)"]
        UES["Multi-Slice UEs (UE-1: eMBB, UE-2: URLLC-like)"]
    end

    %% ----------------------------------------------------
    %% Telemetry Ingestion Flows
    %% ----------------------------------------------------
    %% Fast loop gets direct real-time E2 telemetry
    RAN_KPI -- "Fast Telemetry (~100 ms via E2SM-KPM)" --> XAPP

    %% Slow loop aggregates both RAN and Core telemetry
    RAN_KPI -- "Historical PRB / Delay" --> CROSS_AGG
    CORE_METRICS -- "Nnwdaf_AnalyticsInfo (:8080)" --> CROSS_AGG
    E2E_QOS -- "End-to-End Metrics" --> CROSS_AGG

    %% ----------------------------------------------------
    %% Multi-Timescale Control & Policy Distribution
    %% ----------------------------------------------------
    %% Non-RT to Near-RT Policy Enforcement
    POLICY_GEN -- "A1 Interface (REST :10001)" --> A1_POLICY

    %% Non-RT to Core User-Plane Conditioning (if Core/Joint Bottleneck)
    POLICY_GEN -. "Core Shaping Targets (Delay > Threshold)" .-> CORE_ACT

    %% Near-RT to RAN Radio Actuation (if RAN/Joint Bottleneck)
    XAPP -- "E2 Control (E2SM-RC ID: 3)" --> RAN_ACT

    %% ----------------------------------------------------
    %% Actuation to Data Plane
    %% ----------------------------------------------------
    RAN_ACT -- "RRC Reconfiguration (Inter-Cell Steering)" --> UES
    CORE_ACT -- "User-Plane Shaping (UPF-1 / UPF-2 Queues)" --> UES

    %% ----------------------------------------------------
    %% Closed-Loop Feedback Cycles
    %% ----------------------------------------------------
    %% Feedback into RAN
    UES -. "Radio Channel & Cell PRB Usage" .-> RAN_KPI

    %% Feedback into Core
    UES -. "Slice PDU Sessions & UPF Delay" .-> CORE_METRICS

    %% Feedback into End-to-End SLA Monitoring
    UES -. "Closed-Loop Telemetry (SLA Violations Vs, Latency p95/p99)" .-> E2E_QOS
