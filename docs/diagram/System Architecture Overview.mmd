%% ====================================================================
%% Current System Architecture: O-RAN RIC – NWDAF Closed-Loop Platform
%% ====================================================================

    %% VM-5: OAI nrUE Emulator
    subgraph VM5 ["VM-5 — OAI nrUE (10.102.0.165)"]
        UE1["UE-1: eMBB (SST: 1, SD: 1)"]
        UE2["UE-2: URLLC-like (SST: 222, SD: 123)"]
    end

    %% VM-4: OAI RAN (CU/DUs + FlexRIC)
    subgraph VM4 ["VM-4 — OAI RAN (10.102.0.167)"]
        subgraph VM4_DU ["Distributed Units (DUs)"]
            DU1["DU-1 (Cell-1, PCI 1, Port 4043)"]
            DU2["DU-2 (Cell-2, PCI 2, Port 4044)"]
        end

        subgraph VM4_CU ["Central Unit (CU)"]
            CU_CP["CU-CP (RRC / PDCP-C)"]
            CU_UP["CU-UP (SDAP / PDCP-U)"]
        end

        E2_AGENT["E2 Agent (FlexRIC: KPM ID: 2, RC ID: 3)"]
    end

    %% VM-3: OAI 5G Core & Native NWDAF
    subgraph VM3 ["VM-3 — OAI 5G Core & NWDAF (10.102.0.164)"]
        subgraph VM3_5GC ["5G Core Network Functions (v2.1.0)"]
            AMF["AMF (Access & Mobility)"]
            SMF["SMF (Session Management)"]
            CORE_CP["NRF, UDM, UDR, AUSF, NSSF"]
            UPF["UPF Multi-Slice (UPF-1: eMBB, UPF-2: URLLC)"]
        end

        subgraph VM3_NWDAF ["3GPP NWDAF & Core Adaptation"]
            NWDAF_ENG["Native OAI NWDAF (8 Microservices & MongoDB)"]
            KONG["Kong API Gateway (Port 8080)"]
            CORE_ADAPT["Core Adapter / UPF Shaper"]
        end
    end

    %% VM-1: Non-RT RIC (Coordinator)
    subgraph VM1 ["VM-1 — Non-RT RIC (10.102.0.168)"]
        RAPP["Bottleneck-Aware rApp (Telemetry Aggregator, Classifier & SLA Verifier)"]
        A1_PMS["A1 Policy Management Service (A1 PMS v2.6.0)"]
    end

    %% VM-2: Near-RT RIC (O-RAN SC Dawn)
    subgraph VM2 ["VM-2 — Near-RT RIC (10.102.0.66)"]
        A1_MED["A1 Mediator"]
        XAPP["QoS & Bottleneck-Aware Traffic-Steering xApp"]
        SUB_MGR["Subscription Manager"]
        E2_TERM["E2 Termination (E2Term)"]
        E2_MGR["E2 Manager (E2Mgr)"]
        RNIB["RNIB / DBaaS (Redis 5.0.9)"]
    end

    %% VM-6: Telemetry & Monitoring TSDB
    subgraph VM6 ["VM-6 — Monitoring & TSDB (10.102.0.67)"]
        PROM["Prometheus TSDB"]
        GRAF["Grafana Dashboards"]
        LOGGER["Experiment Logger (Latency, Loss, SLA Churn)"]
    end

    %% ----------------------------------------------------
    %% Internal Connections within Subgraphs
    %% ----------------------------------------------------

    %% VM-4 (RAN) Internal
    DU1 -- "F1-C" --> CU_CP
    DU1 -- "F1-U" --> CU_UP
    DU2 -- "F1-C" --> CU_CP
    DU2 -- "F1-U" --> CU_UP
    CU_CP -.-> E2_AGENT
    CU_UP -.-> E2_AGENT

    %% VM-3 (Core + NWDAF) Internal
    AMF -- "N11" --> SMF
    SMF -- "N4 / PFCP" --> UPF
    CORE_CP -.-> SMF
    UPF -. "Nupf / User-Plane Metrics" .-> NWDAF_ENG
    SMF -. "Slice Load Info" .-> NWDAF_ENG
    NWDAF_ENG --- KONG
    CORE_ADAPT -. "Rate-Limiting / Queue Shaping" .-> UPF

    %% VM-1 (Non-RT RIC) Internal
    RAPP --> A1_PMS

    %% VM-2 (Near-RT RIC) Internal
    A1_MED -- "RMR 20010 (Policy Delivery)" --> XAPP
    XAPP -- "RIC Subscription" --> SUB_MGR
    SUB_MGR --> E2_TERM
    E2_TERM -- "KPI / E2 Indication (E2SM-KPM)" --> XAPP
    XAPP -- "E2 Control (E2SM-RC)" --> E2_TERM
    E2_TERM -. "E2 Setup / Inventory" .-> E2_MGR
    E2_MGR --> RNIB

    %% VM-6 (Monitoring) Internal
    PROM --> GRAF
    PROM --> LOGGER

    %% ----------------------------------------------------
    %% Cross-Domain & Inter-VM Connections
    %% ----------------------------------------------------

    %% Radio / Access Interface
    UE1 == "RFsim (Cell-1, Port 4043)" ==> DU1
    UE2 == "RFsim (Cell-2, Port 4044)" ==> DU2

    %% 3GPP 5G Interfaces (RAN to Core)
    CU_CP -- "N2 / NGAP (SCTP :38412)" --> AMF
    CU_UP -- "N3 / GTP-U (UDP :2152)" --> UPF

    %% O-RAN E2 Interface (RAN to Near-RT RIC)
    E2_AGENT <== "E2 / SCTP (Port 36421)" ==> E2_TERM

    %% O-RAN A1 Interface (Non-RT RIC to Near-RT RIC)
    A1_PMS -- "A1 Policy Type 20008 (REST :10001)" --> A1_MED

    %% 3GPP Nnwdaf Interface (Core to Non-RT RIC)
    KONG -- "Nnwdaf API Exposure (SliceLoadLevel, Delay, Loss)" --> RAPP

    %% Closed-Loop Core Traffic Adaptation
    RAPP -. "Core Shaping Targets" .-> CORE_ADAPT

    %% Telemetry & Monitoring Lines (Dotted)
    UE1 & UE2 -. "UE QoS Telemetry" .-> LOGGER
    DU1 & DU2 -. "PRB Metrics / MAC KPI" .-> PROM
    CU_UP -. "PDCP / User-Plane Metrics" .-> PROM
    NWDAF_ENG -. "Core & Slice Metrics" .-> PROM
    XAPP -. "RIC Decisions & Logs" .-> LOGGER